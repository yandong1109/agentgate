{
  "name": "agentgate-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.vue --fix",
    "lint:check": "eslint . --ext .ts,.vue",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,css,json}\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^0.28.1",
    "echarts": "^5.4.3",
    "element-plus": "^2.8.0",
    "normalize.css": "^7.0.0",
    "nprogress": "^0.2.0",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "vue": "^3.4.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@types/nprogress": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.20.1",
    "husky": "^8.0.3",
    "jsdom": "^24.1.0",
    "lint-staged": "^13.3.0",
    "postcss": "^8.4.39",
    "prettier": "^3.3.3",
    "sass": "^1.77.6",
    "typescript": "^5.4.0",
    "vite": "^8.2.1",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.1.10"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json,md}": [
      "prettier --write"
    ]
  }
}
